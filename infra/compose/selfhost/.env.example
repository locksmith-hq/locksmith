# Names only. `bootstrap.sh` creates `.env` (mode 0600) with generated values; never commit it.
# Generated secrets (do not set by hand unless you run --external-keys, see below):
#   POSTGRES_PASSWORD LOCKSMITH_OWNER_PASSWORD LOCKSMITH_APP_PASSWORD LOCKSMITH_AUDIT_VERIFIER_PASSWORD
#   LOCKSMITH_GATEWAY_SERVICE_TOKEN LOCKSMITH_AGENT_SIGNING_KEY KEYCLOAK_ADMIN_PASSWORD (demo-oidc only)
#   OPENBAO_CONTROL_PLANE_TOKEN OPENBAO_GATEWAY_TOKEN OPENBAO_AUDIT_CHECKPOINT_TOKEN
#
# Key provider. Bundled: OPENBAO_ADDR=http://openbao:8200 and COMPOSE_PROFILES contains bundled-keys.
# External (`bootstrap.sh --external-keys`): you provide these, bootstrap generates none of them:
#   OPENBAO_ADDR=            # address of your OpenBao (transit enabled, keys `gateway` and `audit-checkpoint`)
#   OPENBAO_CONTROL_PLANE_TOKEN=   # may only update transit/encrypt/gateway
#   OPENBAO_GATEWAY_TOKEN=         # may only update transit/decrypt/gateway
#   OPENBAO_AUDIT_CHECKPOINT_TOKEN=  # may only update transit/sign/audit-checkpoint
COMPOSE_PROFILES=bundled-keys
OPENBAO_ADDR=
# Sign-in: any OIDC issuer (public values). Leave empty to disable human sign-in.
LOCKSMITH_OIDC_ISSUER=
LOCKSMITH_OIDC_AUDIENCE=
LOCKSMITH_OIDC_JWKS_URL=
# Images (default: released images from ghcr.io/locksmith-hq at LOCKSMITH_VERSION).
LOCKSMITH_VERSION=latest
# LOCKSMITH_CONTROL_PLANE_IMAGE=
# LOCKSMITH_GATEWAY_IMAGE=
# Ports (published on 127.0.0.1 only) and the TLS profile.
LOCKSMITH_API_PORT=8080
LOCKSMITH_GATEWAY_PORT=8090
# LOCKSMITH_DOMAIN=localhost
# LOCKSMITH_TLS_BIND_ADDR=127.0.0.1
# Gateway bindings file (written by bootstrap.sh).
# LOCKSMITH_BINDINGS_FILE=
