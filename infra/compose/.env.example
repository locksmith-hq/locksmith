# Dev-only values. Never real credentials. Copy to .env (gitignored) to override.
POSTGRES_USER=locksmith
POSTGRES_PASSWORD=locksmith-dev-only
POSTGRES_DB=locksmith
# OpenBao dev-mode root token (dev-only).
OPENBAO_DEV_ROOT_TOKEN=dev-only-root
# Image override (default is the Docker Hub image; ghcr.io is blocked in some sandboxes).
OPENBAO_IMAGE=openbao/openbao:2.7.2
