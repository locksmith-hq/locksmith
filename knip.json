{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "apps/web": {
      "entry": [
        "src/mockup/main.tsx",
        "src/**/*.test.{ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "tailwindcss",
        "tw-animate-css",
        "@locksmith-hq/styles"
      ]
    },
    "apps/desktop": {
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "@locksmith-hq/styles",
        "tailwindcss",
        "tw-animate-css"
      ]
    },
    "packages/ui": {
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "packages/control-plane-client": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "tests/api-contract": {
      "entry": [
        "src/run.ts",
        "src/scenarios/*.ts",
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/sdk": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "apps/api": {
      "entry": [
        "src/main.ts",
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ],
      "ignore": [
        "src/db/types.ts"
      ],
      "ignoreDependencies": [
        "kysely-codegen",
        "@types/express"
      ]
    },
    "design-system/packages/*": {
      "entry": [
        "src/index.tsx",
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ]
    },
    "design-system/docs": {
      "project": [
        "src/**/*.{ts,tsx}",
        "*.mjs"
      ],
      "ignoreDependencies": [
        "tailwindcss",
        "tw-animate-css",
        "@locksmith-hq/styles"
      ]
    },
    "design-system/mcp": {
      "entry": [
        "server.mjs",
        "*.test.mjs"
      ],
      "project": [
        "*.mjs"
      ]
    }
  }
}
