{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Locksmith chart values",
  "description": "Secrets are referenced by Secret name only. Every object here forbids unknown properties, so a literal password, token, DSN or key field is rejected.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "secrets",
    "keyProvider"
  ],
  "properties": {
    "nameOverride": {
      "type": "string",
      "maxLength": 40,
      "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$"
    },
    "images": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "controlPlane",
        "gateway"
      ],
      "properties": {
        "controlPlane": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9./_-]+$"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            },
            "tag": {
              "type": "string",
              "pattern": "^([A-Za-z0-9_][A-Za-z0-9_.-]{0,127})?$"
            }
          }
        },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9./_-]+$"
            },
            "digest": {
              "type": "string",
              "pattern": "^(sha256:[a-f0-9]{64})?$"
            },
            "tag": {
              "type": "string",
              "pattern": "^([A-Za-z0-9_][A-Za-z0-9_.-]{0,127})?$"
            }
          }
        },
        "pullPolicy": {
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "database",
        "internal",
        "keyProvider"
      ],
      "properties": {
        "database": {
          "type": "object",
          "description": "Secret with keys DATABASE_URL and DATABASE_OWNER_URL.",
          "additionalProperties": false,
          "required": [
            "existingSecret"
          ],
          "properties": {
            "existingSecret": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
              "description": "Name of an existing Secret; the chart never creates or stores secret values."
            }
          }
        },
        "internal": {
          "type": "object",
          "description": "Secret with keys LOCKSMITH_GATEWAY_SERVICE_TOKEN and LOCKSMITH_AGENT_SIGNING_KEY.",
          "additionalProperties": false,
          "required": [
            "existingSecret"
          ],
          "properties": {
            "existingSecret": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
              "description": "Name of an existing Secret; the chart never creates or stores secret values."
            }
          }
        },
        "keyProvider": {
          "type": "object",
          "description": "Secret with keys OPENBAO_CONTROL_PLANE_TOKEN, OPENBAO_AUDIT_CHECKPOINT_TOKEN and OPENBAO_GATEWAY_TOKEN.",
          "additionalProperties": false,
          "required": [
            "existingSecret"
          ],
          "properties": {
            "existingSecret": {
              "type": "string",
              "minLength": 1,
              "maxLength": 253,
              "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$",
              "description": "Name of an existing Secret; the chart never creates or stores secret values."
            }
          }
        }
      }
    },
    "keyProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "address"
      ],
      "properties": {
        "address": {
          "type": "string",
          "pattern": "^https?://[^/@\\s]+(/[^\\s]*)?$",
          "description": "OpenBao address; no embedded credentials."
        }
      }
    },
    "oidc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issuer": {
          "type": "string",
          "pattern": "^(https?://[^/@\\s]+(/[^\\s]*)?)?$"
        },
        "audience": {
          "type": "string"
        },
        "jwksUrl": {
          "type": "string",
          "pattern": "^(https?://[^/@\\s]+(/[^\\s]*)?)?$"
        }
      }
    },
    "otlpEndpoint": {
      "type": "string",
      "pattern": "^(https?://[^/@\\s]+(/[^\\s]*)?)?$"
    },
    "logLevel": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_=,:.-]+$"
    },
    "controlPlane": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            }
          }
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "bindingsToml": {
          "type": "string"
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "backoffLimit": {
          "type": "integer",
          "minimum": 0
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "host": {
          "type": "string"
        },
        "gatewayPathPrefix": {
          "type": "string",
          "pattern": "^/"
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "secretName": {
              "type": "string"
            }
          }
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        },
        "required": [
          "enabled"
        ]
      },
      "then": {
        "required": [
          "host"
        ],
        "properties": {
          "host": {
            "minLength": 1
          }
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "egressPorts": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          }
        },
        "egressTo": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "ingressFrom": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "podSecurity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "runAsUser": {
          "type": "integer",
          "minimum": 1
        },
        "runAsGroup": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
