{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 120,
  "ignorePatterns": [
    "**/dist/**",
    "**/node_modules/**",
    "**/schema.d.ts",
    "**/src/db/types.ts",
    "**/*.css",
    "**/target/**",
    "**/package-lock.json",
    "**/*.json",
    "**/*.md",
    "**/*.toml",
    "**/*.yml",
    "**/*.yaml",
    "**/*.html",
    "**/*.sh",
    "**/*.sql"
  ]
}
