{
  "name": "locksmith",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "locksmith",
      "workspaces": [
        "apps/*",
        "packages/*",
        "integrations/*"
      ]
    },
    "apps/docs": {
      "name": "@locksmith/docs",
      "version": "0.0.1"
    },
    "apps/web": {
      "name": "@locksmith/web",
      "version": "0.0.1"
    },
    "node_modules/@locksmith/docs": {
      "resolved": "apps/docs",
      "link": true
    },
    "node_modules/@locksmith/eslint-config": {
      "resolved": "packages/eslint-config",
      "link": true
    },
    "node_modules/@locksmith/tsconfig": {
      "resolved": "packages/tsconfig",
      "link": true
    },
    "node_modules/@locksmith/ui": {
      "resolved": "packages/ui",
      "link": true
    },
    "node_modules/@locksmith/web": {
      "resolved": "apps/web",
      "link": true
    },
    "packages/eslint-config": {
      "name": "@locksmith/eslint-config",
      "version": "0.0.1"
    },
    "packages/tsconfig": {
      "name": "@locksmith/tsconfig",
      "version": "0.0.1"
    },
    "packages/ui": {
      "name": "@locksmith/ui",
      "version": "0.0.1"
    }
  }
}
