  {
    "description": "Send an HTTP request through the gateway; it injects the credential and returns the redacted response.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "type": "string"
        },
        "body_base64": {
          "type": "string"
        },
        "headers": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
            ],
            "type": "array"
          },
          "type": "array"
        },
        "method": {
          "enum": [
            "GET",
            "HEAD",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ],
          "type": "string"
        },
        "secret_id": {
          "format": "uuid",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "secret_id",
        "version",
        "method",
        "url"
      ],
      "type": "object"
    },
    "name": "relay_http_request",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "type": "string"
        },
        "body_base64": {
          "type": "string"
        },
        "headers": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "string"
              }
