  {
    "description": "A credential valid for minutes, scoped to one job, destroyed after. It is not the stored secret: present it as `Authorization: Bearer` to the gateway's `POST /v1/relay` for the one secret it was issued for (never past the grant). Off by default; every issue is audited.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "job": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:/-]+$",
          "type": "string"
        },
        "secret_id": {
          "format": "uuid",
          "type": "string"
        },
        "ttl_secs": {
          "maximum": 900,
          "minimum": 60,
          "type": "integer"
        }
      },
      "required": [
        "secret_id",
        "job",
        "ttl_secs"
      ],
      "type": "object"
    },
    "name": "issue_short_lived_credential",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "credential": {
          "type": "string"
        },
        "credential_id": {
          "format": "uuid",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "type": "string"
        },
        "scope": {
          "type": "string"
        }
      },
      "required": [
        "credential",
        "credential_id",
        "expires_at",
        "scope"
      ],
      "type": "object"
    }
  },
  {
    "name": "get_secret_value",
