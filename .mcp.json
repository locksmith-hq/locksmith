{
  "mcpServers": {
    "postgres": {
      "command": "uvx",
      "args": ["postgres-mcp==0.3.0", "--access-mode=restricted"],
      "env": {
        "DATABASE_URI": "postgresql://${POSTGRES_USER:-locksmith}:${POSTGRES_PASSWORD:-locksmith-dev-only}@127.0.0.1:5432/${POSTGRES_DB:-locksmith}"
      }
    },
    "grafana": {
      "command": "uvx",
      "args": ["mcp-grafana==2.2.0", "-t", "stdio", "--disable-write"],
      "env": {
        "GRAFANA_URL": "http://127.0.0.1:3000"
      }
    }
  }
}
