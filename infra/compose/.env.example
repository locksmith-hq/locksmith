# Dev-only values. Never real credentials. Copy to .env (gitignored) to override.
POSTGRES_USER=locksmith
POSTGRES_PASSWORD=locksmith-dev-only
POSTGRES_DB=locksmith
# Control-plane roles, created by services/control-plane/migrations/0001_roles.sql (dev-only
# passwords; a real deployment pre-creates the roles with its own). locksmith-api migrates through
# DATABASE_OWNER_URL (the bootstrap user on a fresh database, locksmith_owner afterwards) and
# serves requests through DATABASE_URL as locksmith_app.
LOCKSMITH_OWNER_PASSWORD=locksmith-owner-dev-only
LOCKSMITH_APP_PASSWORD=locksmith-app-dev-only
DATABASE_OWNER_URL=postgres://locksmith:locksmith-dev-only@127.0.0.1:5432/locksmith
DATABASE_URL=postgres://locksmith_app:locksmith-app-dev-only@127.0.0.1:5432/locksmith
# OpenBao dev-mode root token (dev-only).
OPENBAO_DEV_ROOT_TOKEN=dev-only-root
# Image override (default is the Docker Hub image; ghcr.io is blocked in some sandboxes).
OPENBAO_IMAGE=openbao/openbao:2.7.2
