{
  "name": "@locksmith-hq/ui",
  "version": "0.1.0",
  "description": "The Locksmith design system: every component, the design tokens and the Tailwind theme, built on shadcn/ui.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/locksmith-hq/locksmith.git",
    "directory": "design-system/ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "files": [
    "dist",
    "styles"
  ],
  "exports": {
    "./styles": "./styles/index.css",
    "./styles/*.css": "./styles/*.css",
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test \"src/**/*.test.ts\" \"*.test.mjs\"",
    "lint": "oxlint -c ../../.oxlintrc.json .",
    "format:check": "oxfmt --check -c ../../.oxfmtrc.json ."
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource/azeret-mono": "^5.3.0",
    "@fontsource/chakra-petch": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "lucide-react": "^1.82.0",
    "motion": "^14.14.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react-day-picker": "^10.0.2",
    "recharts": "^3.8.0",
    "shiki": "^4.6.0",
    "sonner": "^2.0.8"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/node": "^4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.0"
  }
}
