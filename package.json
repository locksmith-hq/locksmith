{
  "private": true,
  "name": "locksmith",
  "workspaces": [
    "apps/*",
    "packages/*",
    "integrations/*",
    "tests/api-contract",
    "design-system/packages/*",
    "design-system/docs",
    "design-system/mcp"
  ],
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint format:check knip typecheck",
    "knip": "knip",
    "changeset": "changeset",
    "release:design-system": "turbo run build --filter=./design-system/packages/* && changeset publish",
    "version:design-system": "changeset version && npm install --package-lock-only"
  },
  "license": "Apache-2.0",
  "packageManager": "npm@11.19.0",
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "knip": "6.48.0",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "turbo": "^2.11.13"
  }
}
