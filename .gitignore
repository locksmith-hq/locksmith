target/
node_modules/
dist/
!crates/locksmithd/dist/
.DS_Store
.env
.env.*
!.env.example
.claude/settings.local.json
.claude/worktrees/
.agent-runs.md

# Leak-test canaries (just canary new)
infra/compose/.canaries
# Audit checkpoint verifier config written by `just up` (public keys of the local stack only)
infra/compose/.audit-verifier.json
# Audit ledger export written by `just audit-export` (one local stack's ledger)
infra/compose/.audit-export/
__pycache__/

# Self-host bundle: generated secrets and the gateway bindings written by bootstrap.sh
infra/compose/selfhost/gateway-bindings.toml

# OpenTofu
.terraform/
# Lock files from the local mirror hold only this platform's h1 hash; commit them once
# `tofu providers lock` can reach the registry for every platform (#479).
.terraform.lock.hcl
