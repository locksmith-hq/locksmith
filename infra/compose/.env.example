# Dev-only values. Never real credentials. Copy to .env (gitignored) to override.
POSTGRES_USER=locksmith
POSTGRES_PASSWORD=locksmith-dev-only
POSTGRES_DB=locksmith
# Control-plane roles, created by services/control-plane/migrations/0001_roles.sql (dev-only
# passwords; a real deployment pre-creates the roles with its own). locksmith-api migrates through
# DATABASE_OWNER_URL (the bootstrap user on a fresh database, locksmith_owner afterwards) and
# serves requests through DATABASE_URL as locksmith_app.
LOCKSMITH_OWNER_PASSWORD=locksmith-owner-dev-only
LOCKSMITH_APP_PASSWORD=locksmith-app-dev-only
# C1 gateway role (OAuth token material and flows), created by migrations/0016_oauth_connections.sql;
# `just gateway` connects as it.
LOCKSMITH_GATEWAY_PASSWORD=locksmith-gateway-dev-only
# S5 audit verifier role (SELECT + BYPASSRLS, INSERT on audit_verify_runs only), created by
# migrations/0008_audit_ledger.sql; used only by the locksmith-audit CLI.
LOCKSMITH_AUDIT_VERIFIER_PASSWORD=locksmith-audit-verifier-dev-only
DATABASE_OWNER_URL=postgres://locksmith:locksmith-dev-only@127.0.0.1:5432/locksmith
DATABASE_URL=postgres://locksmith_app:locksmith-app-dev-only@127.0.0.1:5432/locksmith
LOCKSMITH_GATEWAY_DATABASE_URL=postgres://locksmith_gateway:locksmith-gateway-dev-only@127.0.0.1:5432/locksmith
# OpenBao dev-mode root token (dev-only).
OPENBAO_DEV_ROOT_TOKEN=dev-only-root
# Fixed dev-only transit tokens created by openbao-init.sh (the openbao healthcheck): the
# control plane may only encrypt with the `gateway` key, the gateway test token may only decrypt.
OPENBAO_CONTROL_PLANE_TOKEN=dev-only-control-plane
OPENBAO_GATEWAY_TOKEN=dev-only-gateway
# c1: fixed dev-only token that may only encrypt and decrypt with the `oauth-connections` transit
# key, which wraps the DEKs of sealed OAuth token sets (the gateway's TokenVault).
OPENBAO_GATEWAY_OAUTH_TOKEN=dev-only-gateway-oauth
# S5: fixed dev-only token that may only sign with the Ed25519 `audit-checkpoint` transit key
# (transit/sign/audit-checkpoint). locksmith-api signs audit checkpoints with it; unset disables
# checkpoints. `just up` writes the key's public half to LOCKSMITH_AUDIT_VERIFIER_CONFIG.
OPENBAO_AUDIT_CHECKPOINT_TOKEN=dev-only-audit-checkpoint
LOCKSMITH_AUDIT_VERIFIER_CONFIG=infra/compose/.audit-verifier.json
# Where locksmith-api (`just api`) wraps secret-version DEKs; unset disables version writes.
OPENBAO_ADDR=http://127.0.0.1:8200
# Image override (default is the Docker Hub image; ghcr.io is blocked in some sandboxes).
OPENBAO_IMAGE=openbao/openbao:2.7.2
FLOCI_IMAGE=floci/floci:2.5.0
# S3 gateway (`just gateway`). Dev-only tokens, at least 32 bytes. The control plane reads the same
# service token (`just api`) and the gateway presents it on /internal/v1 (material, agent grants).
# Callers authenticate with agent tokens from POST /v1/agent-tokens, verified through the control
# plane's /.well-known/jwks.json (S4); there is no static caller token.
LOCKSMITH_GATEWAY_SERVICE_TOKEN=dev-only-gateway-service-token-0123456789
LOCKSMITH_CONTROL_PLANE_URL=http://127.0.0.1:8080
LOCKSMITH_GATEWAY_BIND=127.0.0.1:8090
# T1: the local OIDC issuer (Keycloak, compose profile `auth`, realm imported from
# infra/compose/keycloak/locksmith-realm.json). `just api` reads these three public values;
# tokens must name the `locksmith-api` audience (added by a mapper on every realm client).
# KEYCLOAK_IMAGE: Docker Hub (quay.io is blocked in some sandboxes).
KEYCLOAK_IMAGE=keycloak/keycloak:26.0.8
LOCKSMITH_OIDC_ISSUER=http://localhost:8180/realms/locksmith
LOCKSMITH_OIDC_AUDIENCE=locksmith-api
LOCKSMITH_OIDC_JWKS_URL=http://127.0.0.1:8180/realms/locksmith/protocol/openid-connect/certs
# M1 4.2: the control plane revokes a person's consent for an MCP client at the issuer after the
# database revoke (Keycloak admin API, client `locksmith-control-plane` from the realm file; its
# service account holds only realm-management/manage-users). Local dev value only; unset the
# URL to skip the step (non-Keycloak issuers).
LOCKSMITH_ISSUER_ADMIN_URL=http://127.0.0.1:8180
LOCKSMITH_ISSUER_ADMIN_REALM=locksmith
LOCKSMITH_ISSUER_ADMIN_CLIENT_ID=locksmith-control-plane
LOCKSMITH_ISSUER_ADMIN_CLIENT_SECRET=locksmith-control-plane-dev-only
# C1 1.3: the mock third-party OAuth provider is the Keycloak client `locksmith-oauth-mock`
# (confidential, PKCE S256, offline_access, revocation; redirect URI is the gateway callback).
# The gateway enables the `mock` registry entry only when LOCKSMITH_OAUTH_MOCK_ISSUER is set.
# Local dev values only.
LOCKSMITH_OAUTH_MOCK_ISSUER=http://localhost:8180/realms/locksmith
LOCKSMITH_OAUTH_MOCK_CLIENT_ID=locksmith-oauth-mock
LOCKSMITH_OAUTH_MOCK_CLIENT_SECRET=locksmith-oauth-mock-dev-only
