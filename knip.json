{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": []
    },
    "apps/web": {
      "entry": [
        "src/console/main.tsx",
        "src/**/*.test.{ts,tsx}"
      ],
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "tailwindcss",
        "tw-animate-css"
      ]
    },
    "apps/desktop": {
      "project": [
        "src/**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "tailwindcss",
        "tw-animate-css"
      ]
    },
    "packages/control-plane-client": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "tests/api-contract": {
      "entry": [
        "src/run.ts",
        "src/scenarios/*.ts",
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/sdk": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "apps/api": {
      "entry": [
        "src/main.ts",
        "src/**/*.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ],
      "ignore": [
        "src/db/types.ts"
      ],
      "ignoreDependencies": [
        "kysely-codegen",
        "@types/express"
      ]
    },
    "design-system/ui": {
      "entry": [
        "src/*/index.tsx",
        "src/**/*.test.ts",
        "*.test.mjs"
      ],
      "project": [
        "src/**/*.{ts,tsx}",
        "*.mjs"
      ],
      "ignoreDependencies": [
        "@fontsource/azeret-mono",
        "@fontsource/chakra-petch",
        "tailwindcss",
        "tw-animate-css"
      ]
    },
    "design-system/docs": {
      "project": [
        "src/**/*.{ts,tsx}",
        "*.mjs"
      ],
      "ignoreDependencies": [
        "tailwindcss",
        "tw-animate-css"
      ],
      "entry": [
        "src/**/*.test.tsx",
        "src/setup.ts"
      ]
    },
    "design-system/mcp": {
      "entry": [
        "server.mjs",
        "*.test.mjs"
      ],
      "project": [
        "*.mjs"
      ]
    }
  },
  "ignoreIssues": {
    "apps/web/src/console/paid.ts": [
      "exports",
      "types"
    ],
    "apps/web/src/console/data.ts": [
      "exports",
      "types"
    ],
    "apps/web/src/console/pages/access-store.ts": [
      "exports",
      "types"
    ],
    "apps/web/src/console/pages/lifecycleStore.ts": [
      "exports",
      "types"
    ],
    "apps/web/src/console/pages/platformNotify.tsx": [
      "exports",
      "types"
    ]
  }
}
